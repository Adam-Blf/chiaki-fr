<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/host_card_margin"
    android:background="@drawable/bg_host_card"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:longClickable="true"
    android:minHeight="200dp"
    android:padding="20dp"
    android:stateListAnimator="@animator/focus_scale"
    tools:targetApi="o">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/consoleTypeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:paddingStart="10dp"
    android:paddingEnd="10dp"
        android:paddingTop="2dp"
    android:paddingBottom="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="PS5" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/stateChipTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
    android:paddingEnd="14dp"
        android:paddingTop="4dp"
    android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Prête" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/nameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stateChipTextView"
        tools:text="PS5-123" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/hostTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nameTextView"
        tools:text="Adresse : 192.168.1.20" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/bottomInfoTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hostTextView"
        tools:text="Application : Persona 5" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/actionTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/accent"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottomInfoTextView"
        app:layout_goneMarginTop="16dp"
        tools:text="Jouer maintenant" />

</androidx.constraintlayout.widget.ConstraintLayout>
