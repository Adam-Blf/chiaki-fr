<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Sumi and Kaki: one dark Material 3 theme for the whole app, sized for reading at 3 m. -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/ink</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/surface_raised</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorOutlineVariant">@color/outline_subtle</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/ink</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlHighlight">@color/accent_container</item>

        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActivityTransitions">true</item>

        <!-- Every focusable row (preferences, lists) gets the visible focus ring -->
        <item name="android:selectableItemBackground">@drawable/bg_focusable_row</item>
        <item name="android:listSelector">@drawable/bg_focusable_row</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.App.BodyLarge</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.App.BodySmall</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.BodySmall</item>

        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <!-- Text scale: body 20sp, small 18sp, titles 24sp, headline 32sp. Nothing essential below 18sp. -->
    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">26sp</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">30sp</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">32sp</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">40sp</item>
    </style>

    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
    </style>

    <!-- Buttons: big, with a focus ring (stroke) and the 1.06 focus scale -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/tv_button_min_height</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="strokeColor">@color/btn_stroke_filled</item>
        <item name="strokeWidth">3dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="Widget.App.Button.Outlined">
        <item name="backgroundTint">@color/btn_bg_outlined</item>
        <item name="android:textColor">@color/btn_text_outlined</item>
        <item name="iconTint">@color/btn_text_outlined</item>
        <item name="strokeColor">@color/btn_stroke_outlined</item>
    </style>

    <style name="Widget.App.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:minHeight">@dimen/tv_button_min_height</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
        <item name="backgroundTint">@color/btn_bg_text</item>
        <item name="strokeColor">@color/btn_stroke_text</item>
        <item name="strokeWidth">3dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.App.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">@dimen/tv_button_min_height</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:background">@drawable/bg_focusable_row</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:minHeight">@dimen/tv_button_min_height</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:background">@drawable/bg_focusable_row</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">4dp</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.App.TextInput.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">4dp</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.Button.Dialog</item>
        <item name="android:listSelector">@drawable/bg_focusable_row</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_focusable_row</item>
    </style>

    <!-- The stream screen shares the unified theme, on pure black -->
    <style name="StreamTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/stream_background</item>
    </style>
</resources>
