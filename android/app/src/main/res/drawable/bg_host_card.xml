<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_container" />
            <stroke android:width="4dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_container" />
            <stroke android:width="2dp" android:color="@color/outline_strong" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <stroke android:width="2dp" android:color="@color/outline_subtle" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
